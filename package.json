{
  "name": "mdnotes",
  "productName": "飞儿MD",
  "version": "0.1.0",
  "description": "飞儿MD · 跨平台 Markdown 笔记应用（Electron + Vue3）",
  "main": "out/main/index.js",
  "author": "xupengfei",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "web": "vite --config vite.web.config.ts",
    "web:build": "vite build --config vite.web.config.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist:mac": "bash scripts/package-mac.sh",
    "sign:mac": "codesign --force --deep --sign - \"release/mac-arm64/飞儿MD.app\"",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {},
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "dompurify": "^3.2.3",
    "electron": "^33.3.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "element-plus": "^2.9.1",
    "highlight.js": "^11.11.0",
    "katex": "^0.16.11",
    "marked": "^14.1.4",
    "marked-gfm-heading-id": "^4.0.1",
    "marked-katex-extension": "^5.0.2",
    "mermaid": "^11.4.1",
    "pinia": "^2.3.0",
    "vite": "^5.4.11",
    "vue": "^3.5.13"
  },
  "build": {
    "appId": "com.xupengfei.feier-md",
    "productName": "飞儿MD",
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "description": "Markdown 文档",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "text/markdown"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "飞儿MD ${version}",
      "contents": [
        {
          "x": 140,
          "y": 200
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    }
  }
}
